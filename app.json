{
  "expo": {
    "name": "Salon Manager",
    "slug": "salon-app-mobile",
    "scheme": "salonapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "splash": {
      "backgroundColor": "#F5F3EE",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.salonmanager.mobile"
    },
    "android": {
      "package": "com.salonmanager.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3EE"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-image-picker",
      "expo-image-manipulator"
    ]
  }
}
